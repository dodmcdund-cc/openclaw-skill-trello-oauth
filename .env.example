# Trello OAuth 1.0a — configuration
# Copier ce fichier en .env, remplir les valeurs, puis chmod 600 .env

# === Credentials (récupérés sur https://trello.com/apps/admin) ===
# L'API key est publique (peut figurer en clair)
TRELLO_API_KEY=__API_KEY__
# L'OAuth secret est sensible (utilisé pour signer les requêtes OAuth)
TRELLO_OAUTH_SECRET=__OAUTH_SECRET__

# === Callback HTTP local (pour le flow OAuth 3-step) ===
# Port du serveur HTTP lancé par `trello_auth.py --setup`
TRELLO_CALLBACK_PORT=8080
# URL publique joignable depuis ton navigateur (Tailscale MagicDNS, VPN, etc.)
# Doit pointer vers la même machine qui lance --setup
TRELLO_CALLBACK_BASE_URL=http://fred-ghilini-thinkcentre-m920q.tail0d634b.ts.net:8080

# === Stockage du token final ===
# Chemin du fichier où sera sauvegardé le oauth_token final
TRELLO_TOKEN_FILE=~/.openclaw/trello_tokens.json
# Clé AES-GCM (optionnel, base64 32 bytes)
# Pour générer : openssl rand -base64 32
# Sans clé, le token est stocké en clair sur disque (protégé uniquement par chmod du home)
TRELLO_TOKEN_FILE_KEY=

# === Paramètres du token ===
TRELLO_TOKEN_SCOPE=read,write
# 1hour, 1day, 30days, never
TRELLO_TOKEN_EXPIRATION=30days
# Nom affiché à l'utilisateur lors de l'écran de consentement Trello
TRELLO_TOKEN_NAME=OpenClaw-fred_claw